; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="execution-protocol-a-machine-edge-story"
run/main_scene="uid://bypxb6i7ry4w2"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

OmniNarrative="*uid://cgrp8a8t1b237"
OmniSave="*uid://dv5wkhv5cldpf"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/omni_chat/plugin.cfg", "res://addons/omni_narrative/plugin.cfg", "res://addons/omni_save/plugin.cfg", "res://addons/omni_term/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://location/translation/pt_BR.po")

[omni_chat]

paths/effects="res://src/scripts/effects/"

[omni_narrative]

paths/dialogues="res://location/"
paths/translations="res://location/translation/"

[omni_term]

paths/effects="res://src/scripts/effects/"
paths/commands="res://src/scripts/commands/"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
